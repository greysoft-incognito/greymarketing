{
    "name": "greymarketing",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "api:dev": "pnpm --filter ./api dev",
        "api:build": "pnpm --filter ./api build",
        "app:dev": "pnpm --filter @greymarketing/app dev",
        "app:build": "pnpm --filter @greymarketing/app build",
        "app:typecheck": "pnpm --filter @greymarketing/app typecheck"
    }
}
